VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Optional local-only helper keys. Do not expose these to frontend code.
FIRECRAWL_API_KEY=
APIFY_API_KEY=

# Supabase Edge Function secrets, not frontend env.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# Existing Hoursback WhatsApp gateway provider.
WHATSAPP_PROVIDER=waba_gateway
WABA_GATEWAY_BASE_URL=https://waba.hoursback.xyz
WABA_GATEWAY_API_KEY=
WABA_GATEWAY_WEBHOOK_SECRET=
# Optional only when the gateway uses a fixed sender instead of the connected number.
WABA_GATEWAY_PHONE_NUMBER_ID=
